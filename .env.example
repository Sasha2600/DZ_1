# Скопируйте этот файл в .env и при необходимости отредактируйте значения.

# Адрес локального сервера 
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# OpenAI-совместимым API — подставьте сюда реальный секретный ключ.
LM_STUDIO_API_KEY=

# Идентификаторы моделей — как они называются в LM Studio
# (вкладка Local Server -> Model Identifier)
CHEAP_MODEL=google/gemma-4-e2b
ADVANCED_MODEL=google/gemma-4-12b-qat

# Защита от Dead Loop
MAX_ITERATIONS=3
REQUEST_TIMEOUT_SECONDS=30
TOTAL_CYCLE_TIMEOUT_SECONDS=15
MAX_DIALOG_TOKENS_APPROX=8000
